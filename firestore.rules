rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    // Check if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Get current user's document
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getAccountType() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountType', '') 
        : '';
    }

    function getUserOrgId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('organizationId', '') 
        : '';
    }

    function isSameOrg(docOrgId) {
      // Allow if doc doesn't strictly have an orgId (for backwards compatibility/global docs) or if it matches
      return docOrgId == null || docOrgId == getUserOrgId();
    }

    function isOrgMatchForWrite(reqResource, existingResource) {
      // Ensure the new data maintains the correct orgId, and if updating, the old data was in the same org
      let uOrgId = getUserOrgId();
      let newOrgValid = reqResource.data.get('organizationId', '') == '' || uOrgId == '' || reqResource.data.organizationId == uOrgId;
      let oldOrgValid = existingResource == null || existingResource.data.get('organizationId', '') == '' || uOrgId == '' || existingResource.data.organizationId == uOrgId;
      return newOrgValid && oldOrgValid;
    }

    // Check user role
    function isSuperAdmin() {
      return isAuthenticated() && getAccountType() == 'super_admin';
    }

    function isHeadCoach() {
      return isAuthenticated() && (getAccountType() == 'head_coach' || getAccountType() == 'coach');
    }

    function isAthlete() {
      return isAuthenticated() && getAccountType() == 'athlete';
    }

    function isStaff() {
      return isAuthenticated() && getAccountType() == 'support_staff';
    }

    // Global Super Admin Rule - override
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // --- Collections ---

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isAuthenticated() && isSameOrg(resource.data.organizationId);
      // Users can only update their own base profile, or Head Coach/Staff can update members of their org
      allow write: if isAuthenticated() && (
        request.auth.uid == userId || 
        ((isHeadCoach() || isStaff()) && isOrgMatchForWrite(request.resource, resource))
      );

      // Allow access to all subcollections
      match /{document=**} {
        allow read: if isAuthenticated();
        allow write: if isHeadCoach() || isStaff() || (isAuthenticated() && request.auth.uid == userId);
      }
    }

    // ORGANIZATIONS
    match /organizations/{orgId} {
      allow read: if isAuthenticated(); // Anyone can read an org for joining
      allow write: if isHeadCoach() && orgId == getUserOrgId(); // Only coach of this org can update it
    }

    // PROFILES (Legacy)
    match /coaches/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
    match /students/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
    match /staff/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // INVITATIONS
    match /coachInvitations/{inviteId} {
      allow read: if isAuthenticated() && resource.data.coachId == request.auth.uid;
      allow write: if isAuthenticated() && isOrgMatchForWrite(request.resource, resource);
    }
    match /staffInvitations/{inviteId} {
      allow read: if isAuthenticated();
      allow write: if isHeadCoach() && isOrgMatchForWrite(request.resource, resource);
    }
    
    // APPROVAL REQUESTS
    match /approvalRequests/{requestId} {
      allow read: if isAuthenticated() && isSameOrg(resource.data.organizationId);
      allow create: if isAuthenticated();
      allow update, delete: if isHeadCoach() && isSameOrg(resource.data.organizationId);
    }

    // RELATIONSHIPS
    match /coachAthleteRelationships/{relId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Could be tightened, but both coach and athlete need to manage
    }
    match /staffRelationships/{relId} {
      allow read: if isAuthenticated();
      allow write: if isHeadCoach() || (isAuthenticated() && resource.data.staffId == request.auth.uid);
    }

    // CORE DATA COLLECTIONS (wellness, schedules, notes, etc.)
    match /wellness/{docId} {
      allow read: if isAuthenticated() && isSameOrg(resource.data.organizationId);
      allow create, update: if isAuthenticated() && request.resource.data.athleteId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.athleteId == request.auth.uid;
    }

    match /schedules/{docId} {
      allow read: if isAuthenticated() && isSameOrg(resource.data.organizationId);
      allow create, delete: if (isHeadCoach() || isStaff()) && isOrgMatchForWrite(request.resource, resource);
      allow update: if isAuthenticated() && isOrgMatchForWrite(request.resource, resource); 
    }

    match /notes/{docId} {
      allow read: if isAuthenticated() && isSameOrg(resource.data.organizationId);
      allow write: if (isHeadCoach() || isStaff()) && isOrgMatchForWrite(request.resource, resource);
    }

    match /competitions/{docId} {
      allow read: if isAuthenticated() && isSameOrg(resource.data.organizationId);
      allow write: if (isHeadCoach() || isStaff()) && isOrgMatchForWrite(request.resource, resource);
    }

    match /calendarEvents/{docId} {
      allow read: if isAuthenticated() && isSameOrg(resource.data.organizationId);
      allow write: if (isHeadCoach() || isStaff()) && isOrgMatchForWrite(request.resource, resource);
    }

    match /notifications/{docId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
    }

    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
    }

    match /medical/{docId} {
      allow read, write: if (isHeadCoach() || isStaff()) && isSameOrg(resource.data.organizationId); 
    }

    match /trainingLogs/{docId} {
      allow read: if isAuthenticated() && isSameOrg(resource.data.organizationId);
      allow write: if (isHeadCoach() || isStaff() || (isAuthenticated() && request.resource.data.athleteId == request.auth.uid)) && isOrgMatchForWrite(request.resource, resource);
    }
    
    match /attendance/{docId} {
      allow read: if isAuthenticated() && isSameOrg(resource.data.organizationId);
      allow write: if (isHeadCoach() || isStaff() || isAuthenticated()) && isOrgMatchForWrite(request.resource, resource);
    }
    
    match /invitations/{inviteId} {
      allow read: if isAuthenticated() && isSameOrg(resource.data.organizationId);
      allow write: if isHeadCoach() && isOrgMatchForWrite(request.resource, resource);
    }

    match /auditLogs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isHeadCoach() || isSuperAdmin();
      allow update, delete: if false; 
    }

    match /posts/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /activities/{docId} {
      allow read: if isAuthenticated() && isSameOrg(resource.data.organizationId);
      allow write: if isAuthenticated() && isOrgMatchForWrite(request.resource, resource);
    }
    match /groups/{docId} {
      allow read: if isAuthenticated() && isSameOrg(resource.data.organizationId);
      allow write: if isAuthenticated() && isOrgMatchForWrite(request.resource, resource);
    }
    match /training_plans/{docId} {
      allow read: if isAuthenticated() && isSameOrg(resource.data.organizationId);
      allow write: if isAuthenticated() && isOrgMatchForWrite(request.resource, resource);
    }
    match /athletes/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /insights/{docId} {
      allow read: if isAuthenticated() && isSameOrg(resource.data.organizationId);
      allow write: if isAuthenticated() && isOrgMatchForWrite(request.resource, resource);
    }
    match /trainingGroups/{docId} {
      allow read: if isAuthenticated() && isSameOrg(resource.data.organizationId);
      allow write: if isAuthenticated() && isOrgMatchForWrite(request.resource, resource);
    }
    match /documents/{docId} {
      allow read: if isAuthenticated() && isSameOrg(resource.data.organizationId);
      allow write: if isAuthenticated() && isOrgMatchForWrite(request.resource, resource);
    }
  }
}
